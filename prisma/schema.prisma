datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  COORDINATOR
  TEACHER
  ACCOUNTS
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("COORDINATOR") // OWNER, COORDINATOR, TEACHER, ACCOUNTS
  teacherId String?  @unique
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  active    Boolean  @default(true)
  passwordHash    String?
  inviteToken     String?  @unique
  inviteExpiresAt DateTime?
  /// Bumped when the password is set, reset or revoked; sessions signed with an older value stop working.
  sessionVersion  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guardian {
  id             String    @id @default(cuid())
  name           String
  whatsappNumber String
  email          String?
  country        String    @default("India")
  timeZone       String    @default("Asia/Kolkata")
  notes          String?
  students       Student[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Student {
  id                String              @id @default(cuid())
  studentCode       String              @unique
  name              String
  grade             String
  board             String              @default("CBSE")
  medium            String              @default("English")
  guardianId        String?
  guardian          Guardian?           @relation(fields: [guardianId], references: [id])
  guardianName      String
  whatsappNumber    String
  email             String?
  country           String              @default("India")
  timeZone          String              @default("Asia/Kolkata")
  joiningDate       DateTime            @default(now())
  preferredTimings  String?
  /// Days that usually suit the student, as JSON ("[1,3,5]", 0 = Sunday). A preference only: never books a class.
  preferredDays     String?
  learningGoals     String?
  coordinatorNotes  String?
  status            String              @default("ACTIVE")
  draftData         String?
  packages          StudentPackage[]
  enrolments        SubjectEnrollment[]
  sessions          Session[]
  invoices          Invoice[]
  payments          Payment[]
  followUps         FollowUp[]
  progressReports   StudentProgress[]
  assessments       Assessment[]
  parentConcerns    ParentConcern[]
  /// The parent form submission this admission came from (if any).
  sourceSubmission  ParentSubmission?   @relation("ConvertedSubmission")
  /// Parent form submissions staff associated with this existing student.
  linkedSubmissions ParentSubmission[]  @relation("LinkedSubmission")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Subject {
  id          String              @id @default(cuid())
  name        String              @unique
  code        String              @unique
  category    String              @default("Academic")
  color       String              @default("#2563eb")
  enrolments  SubjectEnrollment[]
  sessions    Session[]
  allocations SubjectAllocation[]
  progress    StudentProgress[]
  assessments Assessment[]
  createdAt   DateTime            @default(now())
}

model Teacher {
  id             String              @id @default(cuid())
  name           String
  email          String              @unique
  phone          String
  subjects       String // Comma-separated or specialty
  grades         String // Supported grades
  country        String              @default("India")
  timeZone       String              @default("Asia/Kolkata")
  active         Boolean             @default(true)
  defaultRate    Int                 @default(500) // Base Hourly rate in INR
  gradeRates     String? // JSON string: rates per standard/grade e.g. {"10th Grade": 500, "11th Grade": 600, "12th Grade": 700}
  /// Optional profile details (e.g. from the trainer sign-up form). Bank details are never stored.
  location       String?
  qualification  String?
  syllabus       String?
  devices        String?
  /// "Mon, Tue, …" in week order
  availableDays  String?
  availableTimes String?
  /// WhatsApp number when different from the phone number
  whatsapp       String?
  /// Internal notes: shown to staff, never to the trainer
  notes          String?
  user           User?
  enrolments     SubjectEnrollment[]
  timetableSlots TimetableSlot[]
  sessions       Session[]
  payoutItems    PayoutItem[]
  progressNotes  StudentProgress[]
  assessments    Assessment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model SubjectEnrollment {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  // Null until a trainer is assigned; a removed trainer leaves the enrolment in place.
  teacherId      String?
  teacher        Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  status         String    @default("ACTIVE")
  targetExamDate DateTime?
  notes          String?
  timetableSlots TimetableSlot[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([studentId, subjectId])
}

// One recurring weekly class for an enrolment (many per enrolment). Times are
// wall-clock times in `timeZone`; dated Sessions are generated from it.
model TimetableSlot {
  id             String            @id @default(cuid())
  enrolmentId    String
  enrolment      SubjectEnrollment @relation(fields: [enrolmentId], references: [id], onDelete: Restrict)
  teacherId      String?
  teacher        Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  weekday        Int // 0 = Sunday ... 6 = Saturday, in timeZone
  startMinutes   Int // local start, minutes after midnight
  endMinutes     Int // local end on the same day (overnight slots are not allowed)
  timeZone       String // IANA zone, e.g. Asia/Dubai
  effectiveFrom  DateTime
  effectiveUntil DateTime? // exclusive; null = open-ended
  active         Boolean           @default(true)
  previousSlotId String? // the version this slot replaced when edited
  createdByName  String
  createdByRole  String
  updatedByName  String?
  sessions       Session[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([enrolmentId])
  @@index([teacherId])
}

model PackageTemplate {
  id              String           @id @default(cuid())
  name            String
  totalCredits    Int
  durationMinutes Int              @default(60)
  defaultPrice    Int
  currency        String           @default("INR")
  notes           String?
  packages        StudentPackage[]
  createdAt       DateTime         @default(now())
}

model StudentPackage {
  id                     String              @id @default(cuid())
  packageNumber          String              @unique
  studentId              String
  student                Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId             String?
  template               PackageTemplate?    @relation(fields: [templateId], references: [id])
  name                   String
  totalCredits           Int
  durationMinutes        Int                 @default(60)
  startDate              DateTime            @default(now())
  expiryDate             DateTime?
  price                  Int
  currency               String              @default("INR")
  status                 String              @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, EXHAUSTED, EXPIRED, CLOSED
  cancellationNoticeHours Int                @default(4)
  noShowDeductCredit     Boolean             @default(true)
  notes                  String?
  allocations            SubjectAllocation[]
  creditLedgers          CreditLedger[]
  sessions               Session[]
  invoices               Invoice[]
  followUps              FollowUp[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model SubjectAllocation {
  id               String         @id @default(cuid())
  packageId        String
  package          StudentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  allocatedCredits Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([packageId, subjectId])
}

model CreditLedger {
  id                 String         @id @default(cuid())
  packageId          String
  package            StudentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  subjectId          String?
  eventType          String // PURCHASE_INITIAL, REALLOCATION_IN, REALLOCATION_OUT, SESSION_RESERVED, SESSION_UNRESERVED, SESSION_CONSUMED, SESSION_REVERSED, MANUAL_ADJUSTMENT
  creditsDelta       Int // e.g. -1 for consumption, +1 for reversal/allocation
  resultingRemaining Int?
  sessionId          String?
  reason             String
  actorRole          String
  actorName          String
  metadata           String? // JSON string
  createdAt          DateTime       @default(now())
}

model Session {
  id                     String            @id @default(cuid())
  packageId              String
  package                StudentPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  studentId              String
  student                Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId              String
  teacher                Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId              String
  subject                Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scheduledStartTimeUtc  DateTime
  scheduledEndTimeUtc    DateTime
  durationMinutes        Int               @default(60)
  status                 String            @default("SCHEDULED") // SCHEDULED, COMPLETED, STUDENT_NO_SHOW, TEACHER_NO_SHOW, CANCELLED, RESCHEDULED
  meetingUrl             String?
  recurrenceId           String?
  timetableSlotId        String? // set when generated from a weekly timetable slot
  timetableSlot          TimetableSlot?    @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  occurrenceDate         String? // local date (YYYY-MM-DD, slot time zone) of the generated occurrence
  rescheduledFromId      String?
  rescheduledToId        String?
  isCreditReserved       Boolean           @default(true)
  isCreditConsumed       Boolean           @default(false)
  attendance             AttendanceRecord?
  payoutItems            PayoutItem[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  // A slot produces at most one class per date, so regeneration is idempotent.
  @@unique([timetableSlotId, occurrenceDate])
}

model AttendanceRecord {
  id                    String               @id @default(cuid())
  sessionId             String               @unique
  session               Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionOutcome        String // COMPLETED, STUDENT_NO_SHOW, TEACHER_NO_SHOW, CANCELLED
  studentAttendance     String // PRESENT, LATE, ABSENT
  actualDurationMinutes Int                  @default(60)
  topicCovered          String
  homework              String?
  studentProgressNote   String?
  markedByRole          String
  markedByName          String
  markedAt              DateTime             @default(now())
  isReversed            Boolean              @default(false)
  reversalReason        String?
  reversedAt            DateTime?
  reversedByName        String?
  revisions             AttendanceRevision[]
  correctionRequests    AttendanceCorrectionRequest[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model AttendanceRevision {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  sessionId          String?
  previousOutcome    String
  newOutcome         String
  previousAttendance String
  newAttendance      String
  reason             String
  actorRole          String
  actorName          String
  createdAt          DateTime         @default(now())
}

model Invoice {
  id            String              @id @default(cuid())
  invoiceNumber String              @unique
  studentId     String
  student       Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  packageId     String?
  package       StudentPackage?     @relation(fields: [packageId], references: [id])
  issueDate     DateTime            @default(now())
  dueDate       DateTime
  subtotal      Int // minor units or rupees
  discount      Int                 @default(0)
  totalAmount   Int
  paidAmount    Int                 @default(0)
  balanceDue    Int
  currency      String              @default("INR")
  status        String              @default("UNPAID") // DRAFT, UNPAID, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  notes         String?
  items         InvoiceLineItem[]
  instalments   InvoiceInstalment[]
  allocations   PaymentAllocation[]
  followUps     FollowUp[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Int
  amount      Int
  createdAt   DateTime @default(now())
}

model InvoiceInstalment {
  id               String              @id @default(cuid())
  invoiceId        String
  invoice          Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  instalmentNumber Int
  dueDate          DateTime
  amount           Int
  paidAmount       Int                 @default(0)
  status           String              @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE
  allocations      PaymentAllocation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Payment {
  id             String              @id @default(cuid())
  paymentNumber  String              @unique
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount         Int
  currency       String              @default("INR")
  receivedDate   DateTime            @default(now())
  paymentMethod  String // UPI, BANK_TRANSFER, CASH, CARD
  reference      String?
  proofFileName  String?
  proofUrl       String?
  isVerified     Boolean             @default(false)
  verifiedAt     DateTime?
  verifiedByName String?
  verifiedByRole String?
  notes          String?
  allocations    PaymentAllocation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model PaymentAllocation {
  id           String             @id @default(cuid())
  paymentId    String
  payment      Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  instalmentId String?
  instalment   InvoiceInstalment? @relation(fields: [instalmentId], references: [id])
  amount       Int
  createdAt    DateTime           @default(now())
}

model FollowUp {
  id                  String          @id @default(cuid())
  studentId           String
  student             Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceId           String?
  invoice             Invoice?        @relation(fields: [invoiceId], references: [id])
  packageId           String?
  package             StudentPackage? @relation(fields: [packageId], references: [id])
  type                String // DUE_PAYMENT, OVERDUE_PAYMENT, PACKAGE_EXHAUSTION, PACKAGE_EXPIRY, ACADEMIC_CHECKIN, RENEWAL
  assignedStaff       String
  contactDate         DateTime        @default(now())
  outcome             String? // PROMISED_PAYMENT, REQUESTED_CALLBACK, DISPUTED, RESOLVED, UNREACHABLE
  parentResponse      String?
  promisedPaymentDate DateTime?
  nextActionDate      DateTime?
  notes               String?
  isResolved          Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model PayoutRun {
  id             String       @id @default(cuid())
  runNumber      String       @unique
  periodStart    DateTime
  periodEnd      DateTime
  totalSessions  Int          @default(0)
  totalAmount    Int          @default(0)
  currency       String       @default("INR")
  status         String       @default("DRAFT") // DRAFT, APPROVED, PAID
  approvedByName String?
  approvedAt     DateTime?
  paidAt         DateTime?
  items          PayoutItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PayoutItem {
  id              String     @id @default(cuid())
  payoutRunId     String?
  payoutRun       PayoutRun? @relation(fields: [payoutRunId], references: [id])
  teacherId       String
  teacher         Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionDate     DateTime
  durationMinutes Int
  rateSnapshot    Int
  amount          Int
  status          String     @default("PENDING") // PENDING, APPROVED, PAID
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([sessionId])
}

model StudentProgress {
  id                      String   @id @default(cuid())
  studentId               String
  student                 Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId               String
  subject                 Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId               String
  teacher                 Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  monthYear               String // e.g. "2026-10"
  topicProgress           String
  homeworkCompletionRate  Int      @default(100) // Percentage
  areasOfImprovement      String?
  teacherFeedback         String
  coordinatorNotes        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Assessment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assessmentTitle String
  testDate        DateTime @default(now())
  score           Float
  maxScore        Float
  percentage      Float
  feedback        String?
  createdAt       DateTime @default(now())
}

model ParentConcern {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportedDate    DateTime  @default(now())
  category        String // ACADEMIC, TEACHER_PACE, TIMING, BILLING, OTHER
  description     String
  owner           String
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  nextAction      String?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorRole  String
  actorName  String
  details    String
  createdAt  DateTime @default(now())
}

// Remembers which record a create request produced, so a retried submission
// (double click, network timeout) returns that record instead of a duplicate.
model IdempotencyKey {
  key       String   @id // "<scope>:<client key>"
  scope     String
  entityId  String
  createdAt DateTime @default(now())
}

/// Unfinished admissions. A draft never creates a student, guardian or code;
/// confirming it creates the real records and removes the draft in one transaction.
model AdmissionDraft {
  id            String   @id @default(cuid())
  /// Student name for the drafts list ("Untitled admission" when not yet typed).
  label         String
  /// JSON snapshot of the admission form.
  data          String
  createdByName String
  updatedByName String
  /// Set when the draft was started from a parent form submission.
  parentSubmission ParentSubmission?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A trainer's request to change attendance they already submitted. Staff resolve
/// it with the audited correction (never by editing as the trainer) or decline it.
model AttendanceCorrectionRequest {
  id                  String           @id @default(cuid())
  attendanceRecordId  String
  attendanceRecord    AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedByUserId   String
  requestedByName     String
  requestedOutcome    String?
  requestedAttendance String?
  reason              String
  /// OPEN, RESOLVED (corrected by staff) or DECLINED
  status              String           @default("OPEN")
  resolvedByName      String?
  resolutionNote      String?
  createdAt           DateTime         @default(now())
  resolvedAt          DateTime?

  @@index([status])
  @@index([attendanceRecordId])
}

/// A parent's admission enquiry from the public form (/admission/apply). It never
/// creates a student, guardian, package, invoice, class or reservation: staff
/// review it and confirm an admission through the normal admission form.
model ParentSubmission {
  id                 String                 @id @default(cuid())
  /// Random reference shown to the parent (e.g. XA-7K3M-9QPD). Never used to look anything up publicly.
  reference          String                 @unique
  /// Random key from the parent's browser: a retried submission returns the same reference.
  submissionKey      String                 @unique
  /// Exactly what the parent submitted (JSON), kept unchanged.
  submittedData      String
  /// Copies of submitted values for the inbox, search and duplicate checks.
  studentName        String
  grade              String
  board              String
  subjectNames       String
  guardianName       String
  whatsappNumber     String
  /// Digits only (with country code), for duplicate and sibling checks.
  whatsappKey        String
  country            String
  /// NEW, CONTACTED, AWAITING_INFO, READY, CONVERTED (set only by a confirmed admission), CLOSED
  status             String                 @default("NEW")
  assignedToUserId   String?
  assignedToName     String?
  /// Follow-up date, YYYY-MM-DD in IST.
  followUpOn         String?
  /// First opened by staff (drives the unread indicator).
  seenAt             DateTime?
  admissionDraftId   String?                @unique
  admissionDraft     AdmissionDraft?        @relation(fields: [admissionDraftId], references: [id], onDelete: SetNull)
  convertedStudentId String?                @unique
  convertedStudent   Student?               @relation("ConvertedSubmission", fields: [convertedStudentId], references: [id], onDelete: SetNull)
  convertedAt        DateTime?
  convertedByName    String?
  linkedStudentId    String?
  linkedStudent      Student?               @relation("LinkedSubmission", fields: [linkedStudentId], references: [id], onDelete: SetNull)
  notes              ParentSubmissionNote[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status])
  @@index([whatsappKey])
  @@index([createdAt])
}

/// Staff notes on a parent submission (append-only).
model ParentSubmissionNote {
  id           String           @id @default(cuid())
  submissionId String
  submission   ParentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  body         String
  authorName   String
  authorRole   String
  createdAt    DateTime         @default(now())

  @@index([submissionId])
}
