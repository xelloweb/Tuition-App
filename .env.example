# Database configuration
# Local SQLite for immediate local testing and zero-friction execution
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Supabase deployment in production:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth / App Secret
NEXTAUTH_SECRET="xello-tuition-operational-super-secret-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
DEFAULT_CURRENCY="INR"
DEFAULT_TIMEZONE="Asia/Kolkata"

# Supabase Auth Integration Boundary (Optional production managed auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# WhatsApp Business API Boundary (Automated delivery provider boundary)
WHATSAPP_API_ENDPOINT=""
WHATSAPP_API_TOKEN=""
