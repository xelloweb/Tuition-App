{
  "expo": {
    "name": "Xello Tuition",
    "slug": "xello-tuition",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xellotuition.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c1220"
      },
      "package": "com.xellotuition.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
